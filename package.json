{
  "name": "phonecam",
  "version": "0.2.0",
  "private": true,
  "description": "Use your phone as a wireless 1080p webcam for Teams, Meet, and Zoom. No phone app, no OBS.",
  "type": "module",
  "bin": {
    "phonecam": "./bin/phonecam.js"
  },
  "scripts": {
    "start": "node ./bin/phonecam.js start",
    "test": "node --test test/*.test.js",
    "build:helper": "node -e \"import('./src/setup.js').then((m) => m.buildHelper())\""
  },
  "homepage": "https://github.com/yesabhishek/phonecam-bridge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yesabhishek/phonecam-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/yesabhishek/phonecam-bridge/issues"
  },
  "dependencies": {
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
